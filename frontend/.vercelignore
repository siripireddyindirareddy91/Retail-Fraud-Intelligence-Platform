# Exclude generated/private files without excluding the frontend directory when
# Vercel applies these rules relative to the repository checkout.
**/node_modules/**
**/dist/**
**/.env
**/.env.*
**/.git/**
**/.venv/**
**/.venv-*/**
**/__pycache__/**
**/runtime/**
**/artifacts/**
**/datasets/**
**/*.db
**/*.log
backend/**
