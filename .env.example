# Copy to .env or run `python -m app.cli init-local` from backend.
# Generate a unique random secret; this placeholder intentionally fails validation.
RF_JWT_SECRET=replace-with-a-random-secret-of-at-least-32-bytes
RF_ENVIRONMENT=development
RF_COOKIE_SECURE=false
# Default is an absolute SQLite database under repository/runtime.
# PostgreSQL alternative:
# RF_DATABASE_URL=postgresql+psycopg://retail:YOUR_LOCAL_PASSWORD@127.0.0.1:5432/retail_fraud
# RF_ALLOWED_ORIGINS=["http://127.0.0.1:5173","http://127.0.0.1:5174"]
# For the optional Compose foundation, `python -m app.cli init-postgres`
# appends a random RF_POSTGRES_PASSWORD to the ignored local .env.
